# ============================================================
# Edukey360 OS — environment variables
# Copy to .env.local for local dev; in production add these in
# Vercel → Project → Settings → Environment Variables.
# The app runs on demo data with NO keys; each key you add makes
# the matching agent go live. Nothing breaks if a key is missing.
# ============================================================

# ---------- Database (real data + write-back) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Core AI (powers 6 of the 10 agents) ----------
OPENAI_API_KEY=            # the ONE key that makes most agents live
OPENAI_MODEL=              # optional, default gpt-4o

# ---------- WhatsApp Agent ----------
GUPSHUP_API_KEY=           # or use WATI / Meta WABA
GUPSHUP_SOURCE=            # your approved WhatsApp sender number
GUPSHUP_APP_NAME=Edukey360

# ---------- Email Agent ----------
RESEND_API_KEY=            # Resend (or SendGrid)
RESEND_FROM=Edukey360 <noreply@edukey360.com>

# ---------- Verification Agent (KYC / documents) ----------
IDFY_API_KEY=              # IDfy (Aadhaar/PAN/education/background)
IDFY_ACCOUNT_ID=

# ---------- Interview Coordinator (calendar) ----------
GOOGLE_CALENDAR_TOKEN=     # Google OAuth access token (or use a service acct)

# ---------- AI Voice Calling Agent ----------
VAPI_API_KEY=              # Vapi (all-in-one voice agent) — or Twilio below
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Twilio alternative:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
