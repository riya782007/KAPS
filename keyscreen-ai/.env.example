# ============================================================
# KeyScreen AI — Environment / API Keys template
# Copy this file to ".env.local" and fill in real values.
# NEVER commit the real .env file. India-first providers noted.
# Pricing notes are indicative only — verify current pricing.
# ============================================================

# ---------- APP ----------
NEXT_PUBLIC_APP_URL=https://keyscreen-ai.vercel.app

# ---------- CORE AI (brain of the copilot) ----------
# Resume parsing reasoning, candidate<->JD matching, screening dialogue.
ANTHROPIC_API_KEY=            # Claude API (recommended primary) — the ONLY key needed for live /api/ai
ANTHROPIC_MODEL=             # optional, e.g. claude-3-5-sonnet-latest (defaults if unset)
OPENAI_API_KEY=              # GPT — powers live /api/ai (this is the key to add for the demo)
OPENAI_MODEL=                # optional, default gpt-4o-mini

# ---------- RESUME PARSING (structured extraction) ----------
# Turn a raw CV into fields: subject, qualification, exp, board, CTC, notice, location.
RCHILLI_API_KEY=             # India-focused resume parser (recommended)
AFFINDA_API_KEY=             # alternative resume parser

# ---------- WHATSAPP OUTREACH (candidate messaging) ----------
WHATSAPP_PROVIDER=gupshup    # gupshup | wati | twilio | meta
GUPSHUP_API_KEY=             # Gupshup (popular India WABA partner)
WATI_API_KEY=                # WATI (alt, easy WABA)
META_WABA_TOKEN=             # direct Meta WhatsApp Business API
META_PHONE_NUMBER_ID=

# ---------- AI VOICE CALLING (the "Maya" screening caller) ----------
# Option A — build-your-own stack:
TWILIO_ACCOUNT_SID=          # telephony (calls)
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=          # natural Text-to-Speech voice
DEEPGRAM_API_KEY=            # Speech-to-Text (transcription)
# Option B — all-in-one voice agent (faster to ship):
VAPI_API_KEY=                # Vapi voice-agent platform
BLAND_API_KEY=               # Bland.ai alternative

# ---------- SMS / OTP (India) ----------
MSG91_AUTH_KEY=              # MSG91 (India SMS + OTP)

# ---------- DATABASE & BACKEND ----------
SUPABASE_URL=                # Postgres + auth + storage (recommended)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---------- AUTH (recruiter / school logins) ----------
CLERK_PUBLISHABLE_KEY=       # Clerk (or use Supabase Auth)
CLERK_SECRET_KEY=

# ---------- FILE STORAGE (resume files) ----------
CLOUDINARY_URL=              # Cloudinary (or AWS S3 below)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---------- IDENTITY / KYC VERIFICATION (India) ----------
# Powers the "100% Verified Educators" promise: Aadhaar/PAN + credential checks.
IDFY_API_KEY=                # IDfy (Aadhaar/PAN/education verification)
DIGIO_CLIENT_ID=             # Digio (alt KYC / e-sign)
DIGIO_CLIENT_SECRET=

# ---------- BACKGROUND / EMPLOYMENT CHECKS (India) ----------
SPRINGVERIFY_API_KEY=        # SpringVerify (or OnGrid / AuthBridge)

# ---------- PAYMENTS / BILLING (India) ----------
RAZORPAY_KEY_ID=             # Razorpay (invoices, subscriptions)
RAZORPAY_KEY_SECRET=

# ---------- SCHEDULING (interview slots) ----------
GOOGLE_CLIENT_ID=            # Google Calendar API
GOOGLE_CLIENT_SECRET=

# ---------- TRANSACTIONAL EMAIL ----------
RESEND_API_KEY=              # Resend (or SendGrid)

# ---------- PRODUCT ANALYTICS ----------
POSTHOG_KEY=                 # PostHog (usage + funnel analytics)
